# Copy this file to .env for local development: cp .env.example .env
# On Vercel, add the same variables under Project → Settings → Environment Variables.
# Never commit the real values: this repository is public.

# Supabase → Project Settings → API (or "API Keys")
SUPABASE_URL=https://fjkqdmyxrmbdjubtwzzp.supabase.co

# The publishable key (sb_publishable_...) or the legacy "anon" key.
SUPABASE_PUBLISHABLE_KEY=

# The secret key (sb_secret_...) or the legacy "service_role" key.
# This key can read and write everything, so keep it secret.
SUPABASE_SECRET_KEY=

# Local development only: lets the login cookies work over http://localhost.
# Never set this on Vercel.
# KEYSHIN_DEV=1
